    "@pantoken/plugin-props-minify": "^0.1.4",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "decap-server": "^3.11.3",
    "html-minifier-terser": "^7.2.0",
