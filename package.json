{
  "name": "iywahl-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:baseline": "SITE_OPTIMIZE=false vite build --outDir ../dist-baseline",
