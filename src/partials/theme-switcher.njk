    <button class="instui-button" type="button" data-color-mode="light" aria-label="Light" title="Light" aria-pressed="false"><span class="instui-icon -icon-sun" aria-hidden="true"></span></button>
    <button class="instui-button" type="button" data-color-mode="system" aria-label="System" title="System" aria-pressed="true"><span class="instui-icon -icon-monitor" aria-hidden="true"></span></button>
    <button class="instui-button" type="button" data-color-mode="dark" aria-label="Dark" title="Dark" aria-pressed="false"><span class="instui-icon -icon-moon" aria-hidden="true"></span></button>
  </div>
