---
layout: partials/blog-layout.njk
title: Archive
description: Blog posts by year, from Danny Wahl.
permalink: /blog/archive/index.html
---
<h1>Archive</h1>
{% for group in blog.years %}
<section class="archive-year" aria-labelledby="year-{{ group.year }}">
  <h2 id="year-{{ group.year }}">{{ group.year }}</h2>
  <ul>{% for entry in group.posts %}<li><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time><a href="{{ entry.url }}">{{ entry.title }}</a></li>{% endfor %}</ul>
</section>
{% endfor %}